{
	"schemaVersion": 1,
	"id": "combat_tracker",
	"version": "${version}",
	"name": "AegisAC",
	"description": "Client side anticheat. Watches combat for synthetic input and reports flagged sessions.",
	"authors": [
		"csgd"
	],
	"icon": "assets/combat_tracker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"combat_tracker.CombatTrackerClient"
		]
	},
	"mixins": [
		{
			"config": "combat_tracker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_release}",
		"fabric-api": "*"
	}
}
